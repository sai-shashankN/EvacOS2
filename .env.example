# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# Only HF_TOKEN is required for training + pushing the adapter to HF Hub.
# Everything else is either a default or an optional integration.

# =========================================================================
# Training / deployment
# =========================================================================

# HuggingFace write-scope token — required to push the trained LoRA adapter.
# Generate at: https://huggingface.co/settings/tokens  (role = write)
HF_TOKEN=

# Default HF Hub repo to push the trained adapter to.
# Format: "your-username/evacos-ma-adapter"
HF_ADAPTER_REPO=

# Optional: Weights & Biases API key if you want external metrics dashboards.
# The built-in CSV + SSE dashboard is sufficient; leave blank to skip wandb.
WANDB_API_KEY=
WANDB_PROJECT=evacos-ma

# =========================================================================
# Dev-time orchestration (not needed at training or inference time)
# =========================================================================

# Zhipu AI / z.ai API key for the GLM 5.1 executor (dev-only).
ZHIPU_API_KEY=

# Executor model override for glm-exec.py (dev-only).
GLM_MODEL=glm-5.1
GLM_ENDPOINT=https://api.z.ai/api/coding/paas/v4/chat/completions
