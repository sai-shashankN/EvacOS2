# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# HF_TOKEN is only required when pushing Spaces or trained adapters to HF Hub.
# Everything else is either a default or an optional integration.

# =========================================================================
# Training / deployment
# =========================================================================

# HuggingFace write-scope token — required to push the trained LoRA adapter.
# Generate at: https://huggingface.co/settings/tokens  (role = write)
HF_TOKEN=

# Optional named Hugging Face account slots for hackathon compute.
# Keep HF_TOKEN as the currently active token used by scripts/CLI jobs.
# Copy one of these into HF_TOKEN when you intentionally switch accounts.
HFMAIN_TOKEN=
HFALT1_TOKEN=
HFALT2_TOKEN=
HFALT3_TOKEN=
HFALT4_TOKEN=
HFMAIN_NAMESPACE=your-main-username

# Optional 7B orchestrator launch inputs. Set these after selecting the final
# 3B specialist checkpoints uploaded to HF model repos. Paths should point at
# the adapter directory, usually:
# runs/<run-name>/checkpoints/latest/lora_adapter/floor_agent
HF_7B_ARTIFACT_REPO=your-main-username/evacos2-7b-orchestrator-artifacts
HF_FIRE_ADAPTER_REPO=
HF_FIRE_ADAPTER_PATH=
HF_FLOOD_ADAPTER_REPO=
HF_FLOOD_ADAPTER_PATH=
HF_GAS_ADAPTER_REPO=
HF_GAS_ADAPTER_PATH=

# Default HF Hub repo used by scripts/upload_adapter.py.
# Format: "your-username/evacos-ma-adapter"
HF_ADAPTER_REPO=

# Optional: Weights & Biases API key if you want external metrics dashboards.
# The built-in CSV + SSE dashboard is sufficient; leave blank to skip wandb.
WANDB_API_KEY=
WANDB_PROJECT=evacos-ma

# =========================================================================
# Dev-time orchestration (not needed at training or inference time)
# =========================================================================

# Zhipu AI / z.ai API key for the GLM 5.1 executor (dev-only).
ZHIPU_API_KEY=

# Executor model override for glm-exec.py (dev-only).
GLM_MODEL=glm-5.1
GLM_ENDPOINT=https://api.z.ai/api/coding/paas/v4/chat/completions
